{
  "name": "quantvantage",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise monorepo foundation for QuantVantage.",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @quantvantage/web",
    "dev:api": "npm run dev --workspace @quantvantage/api",
    "lint": "npm run lint --workspace @quantvantage/web",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.2.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}